#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Diseño de filtro FIR pasa-bajos (ventana Kaiser) + generación de
coeficientes en formato C para CMSIS-DSP (arm_fir_f32)
"""

import numpy as np
import scipy.signal as sig
import matplotlib.pyplot as plt


# ============================================================
# ESPECIFICACIONES DEL FILTRO
# ============================================================

fs = 20000.0          # Frecuencia de muestreo [Hz]
f_nyquist = fs / 2

fp = 100.0             # Fin de banda pasante [Hz]
fstop = 300.0          # Inicio de banda de rechazo [Hz]

gpass = 1.0            # Ripple máximo en banda pasante [dB] (no lo usa Kaiser directamente,
                        # Kaiser solo pide la atenuación de rechazo; lo dejamos para referencia)
gstop = 60.0           # Atenuación mínima en banda de rechazo [dB]


# ============================================================
# DISEÑO DEL FILTRO FIR (VENTANA KAISER)
# ============================================================

# Ancho de banda de transición
width = (fstop - fp) / f_nyquist   # normalizado respecto a Nyquist (0..1)

# kaiserord estima el orden N y el beta de la ventana necesarios
# para lograr 'gstop' dB de atenuación con ese ancho de transición
numtaps, beta = sig.kaiserord(gstop, width)

# numtaps debe ser impar para fase lineal tipo I (garantiza taps simétricos)
if numtaps % 2 == 0:
    numtaps += 1

# Frecuencia de corte: punto medio entre fp y fstop
fc = (fp + fstop) / 2

taps = sig.firwin(
    numtaps,
    fc,
    window=('kaiser', beta),
    fs=fs
)


# ============================================================
# INFORMACIÓN DEL FILTRO
# ============================================================

print("==============================================")
print(" FILTRO FIR - VENTANA KAISER")
print("==============================================")
print(f"Frecuencia de muestreo  = {fs:.1f} Hz")
print(f"Frecuencia de Nyquist   = {f_nyquist:.1f} Hz")
print(f"Frecuencia pasante      = {fp:.1f} Hz")
print(f"Frecuencia de rechazo   = {fstop:.1f} Hz")
print(f"Frecuencia de corte     = {fc:.1f} Hz")
print(f"Atenuación mínima       = {gstop:.1f} dB")
print(f"Beta de Kaiser          = {beta:.4f}")
print(f"Cantidad de taps (orden)= {numtaps}")


# ============================================================
# IMPRESIÓN DEL ARRAY EN FORMATO C / CMSIS
# ============================================================

nombre_array = "float_fir_taps"

print("\n// ==============================================")
print(f"// Coeficientes listos para CMSIS-DSP (arm_fir_f32)")
print(f"// FIR_TAP_NUM = {numtaps}")
print("// ==============================================\n")

lines = []
lines.append(f"float32_t {nombre_array}[FIR_TAP_NUM] =")
lines.append("{")
for i, v in enumerate(taps):
    coma = "," if i < len(taps) - 1 else ""
    lines.append(f"    {v: .8e}f{coma}")
lines.append("};")

c_array_text = "\n".join(lines)
print(c_array_text)


# ============================================================
# RESPUESTA EN FRECUENCIA
# ============================================================

w, h = sig.freqz(taps, worN=4096, fs=fs)
H_dB = 20 * np.log10(np.maximum(np.abs(h), 1e-12))

w_normalizada = w / f_nyquist
fp_normalizada = fp / f_nyquist
fstop_normalizada = fstop / f_nyquist

plt.figure(figsize=(10, 6))
plt.plot(w_normalizada, H_dB, label='FIR - Ventana Kaiser')
plt.axvline(fp_normalizada, linestyle='--', label='fp = 100 Hz')
plt.axvline(fstop_normalizada, linestyle='--', label='fstop = 300 Hz')
plt.axhline(-gpass, linestyle=':', label='-1 dB')
plt.axhline(-gstop, linestyle=':', label='-60 dB')

plt.title('Filtro FIR pasa-bajos (Kaiser)')
plt.xlabel('Frecuencia normalizada respecto de Nyquist')
plt.ylabel('Magnitud [dB]')
plt.xlim(0, 1)
plt.ylim(-100, 5)
plt.grid(True)
plt.legend()
plt.show()