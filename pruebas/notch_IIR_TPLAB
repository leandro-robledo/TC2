import numpy as np
import scipy.signal as sig
import matplotlib.pyplot as plt

# ============================================================
# PARAMETROS
# ============================================================

fs = 1000.0       # Hz
f0 = 50.0         # Hz
BW = 1.0          # Hz

Q = f0 / BW

print("Q =", Q)


# ============================================================
# DISEÑO DEL NOTCH
# ============================================================

b, a = sig.iirnotch(
    w0=f0,
    Q=Q,
    fs=fs
)

print("\nCoeficientes:")
print("b =", b)
print("a =", a)


# ============================================================
# RESPUESTA EN FRECUENCIA
# ============================================================

w, h = sig.freqz(
    b,
    a,
    worN=10000,
    fs=fs
)

H_dB = 20*np.log10(np.maximum(np.abs(h), 1e-12))


# ============================================================
# GRAFICO
# ============================================================

plt.figure(figsize=(10,6))

plt.plot(w, H_dB)

plt.axvline(49.5, linestyle='--')
plt.axvline(50.0, linestyle='--')
plt.axvline(50.5, linestyle='--')

plt.axhline(-3, linestyle='--')

plt.xlim(45, 55)
plt.ylim(-80, 5)

plt.xlabel("Frecuencia [Hz]")
plt.ylabel("Magnitud [dB]")
plt.title("Filtro Notch de 50 Hz - BW = 1 Hz")
plt.grid()

plt.show()



