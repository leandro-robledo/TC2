import numpy as np
import scipy.signal as sig
import matplotlib.pyplot as plt

# ============================================================
# PARAMETROS
# ============================================================

fs = 1000.0       # Frecuencia de muestreo [Hz]

# Notch centrado en 50 Hz
f_notch_low = 49.5
f_notch_high = 50.5

# Bandas de transición
f_pass_low = 49.0
f_pass_high = 51.0

# Atenuaciones
gpass = 1.0       # Atenuación máxima en banda pasante [dB]
gstop = 60.0      # Atenuación mínima en banda eliminada [dB]


# ============================================================
# DISEÑO DEL FILTRO NOTCH
# ============================================================

sos = sig.iirdesign(
    wp=[f_pass_low, f_pass_high],
    ws=[f_notch_low, f_notch_high],
    gpass=gpass,
    gstop=gstop,
    analog=False,
    ftype='cheby1',
    output='sos',
    fs=fs
)


# ============================================================
# MOSTRAR SOS
# ============================================================

print("\nSOS obtenidas:")
print(sos)

print("\nCantidad de SOS:", len(sos))
print("Cantidad de coeficientes CMSIS:", len(sos) * 5)


# ============================================================
# RESPUESTA EN FRECUENCIA
# ============================================================

w, h = sig.sosfreqz(
    sos,
    worN=10000,
    fs=fs
)

H_dB = 20 * np.log10(np.maximum(np.abs(h), 1e-12))


# ============================================================
# GRAFICO
# ============================================================

plt.figure(figsize=(10, 6))

plt.plot(w, H_dB)

plt.axvline(49.5, linestyle='--')
plt.axvline(50.0, linestyle='--')
plt.axvline(50.5, linestyle='--')

plt.axhline(-60, linestyle='--')

plt.xlim(45, 55)
plt.ylim(-100, 5)

plt.xlabel("Frecuencia [Hz]")
plt.ylabel("Magnitud [dB]")
plt.title("Filtro IIR Notch - 50 Hz")
plt.grid()

plt.show()


# ============================================================
# CONVERSION A COEFICIENTES CMSIS-DSP
# ============================================================

cmsis_coeffs = []

for section in sos:

    b0, b1, b2, a0, a1, a2 = section

    # Normalizar por a0
    b0 /= a0
    b1 /= a0
    b2 /= a0
    a1 /= a0
    a2 /= a0

    # CMSIS:
    # {b0, b1, b2, a1, a2}
    #
    # Se invierte el signo de a1 y a2
    cmsis_coeffs.extend([
        b0,
        b1,
        b2,
        -a1,
        -a2
    ])


# ============================================================
# MOSTRAR COEFICIENTES
# ============================================================

print("\nCoeficientes para CMSIS-DSP:\n")

for i, c in enumerate(cmsis_coeffs):
    print(f"{i}: {c:.10e}")


# ============================================================
# FORMATO C
# ============================================================

print("\nArray para C:\n")

print("float32_t float_iir_taps[] =")
print("{")

for i, c in enumerate(cmsis_coeffs):

    if i < len(cmsis_coeffs) - 1:
        print(f"    {c:.10e}f,")
    else:
        print(f"    {c:.10e}f")

print("};")


