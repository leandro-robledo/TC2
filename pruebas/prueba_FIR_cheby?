"Cheby Lowpass con FIR a 20KHz"
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import numpy as np
import scipy.signal as sig
import matplotlib.pyplot as plt


# ============================================================
# ESPECIFICACIONES DEL FILTRO
# ============================================================

fs = 20000.0
f_nyquist = fs / 2

fp = 100.0
fstop = 300.0

gpass = 1.0
gstop = 60.0


# ============================================================
# BUSQUEDA DEL NUMERO MINIMO DE TAPS
# ============================================================

# Frecuencia de corte utilizada para el FIR.
# Se coloca aproximadamente en el medio de la transición.

fc = (fp + fstop) / 2


taps_encontrados = None

for numtaps in range(3, 2001, 2):

    # Diseño FIR
    taps = sig.firwin(
        numtaps=numtaps,
        cutoff=fc,
        window='hamming',
        fs=fs,
        pass_zero='lowpass'
    )

    # Respuesta en frecuencia
    w, h = sig.freqz(
        taps,
        worN=16384,
        fs=fs
    )

    H_dB = 20 * np.log10(
        np.maximum(np.abs(h), 1e-12)
    )

    # Banda pasante
    idx_pass = w <= fp

    # Banda de rechazo
    idx_stop = w >= fstop

    # Ripple / atenuación máxima en pasabanda
    max_atten_pass = -np.min(H_dB[idx_pass])

    # Atenuación mínima en stopband
    min_atten_stop = -np.max(H_dB[idx_stop])

    # Verificar especificaciones
    if (
        max_atten_pass <= gpass
        and
        min_atten_stop >= gstop
    ):
        taps_encontrados = taps
        orden = numtaps - 1

        break


# ============================================================
# RESULTADOS
# ============================================================

if taps_encontrados is None:

    print("No se encontró un filtro que cumpla las especificaciones.")

else:

    taps = taps_encontrados

    print("==============================================")
    print(" FILTRO FIR")
    print("==============================================")

    print(f"Frecuencia de muestreo = {fs:.1f} Hz")
    print(f"Frecuencia de Nyquist   = {f_nyquist:.1f} Hz")
    print(f"Frecuencia pasante      = {fp:.1f} Hz")
    print(f"Frecuencia de rechazo   = {fstop:.1f} Hz")
    print(f"Ripple permitido        = {gpass:.1f} dB")
    print(f"Atenuación mínima       = {gstop:.1f} dB")

    print(f"\nOrden del filtro        = {orden}")
    print(f"Cantidad de taps       = {len(taps)}")

    print("\nCoeficientes FIR:")
    print(taps)


    # ========================================================
    # RESPUESTA EN FRECUENCIA
    # ========================================================

    w, h = sig.freqz(
        taps,
        worN=16384,
        fs=fs
    )

    H_dB = 20 * np.log10(
        np.maximum(np.abs(h), 1e-12)
    )


    # ========================================================
    # FRECUENCIAS NORMALIZADAS
    # ========================================================

    w_normalizada = w / f_nyquist

    fp_normalizada = fp / f_nyquist
    fstop_normalizada = fstop / f_nyquist


    # ========================================================
    # GRAFICA
    # ========================================================

    plt.figure(figsize=(10, 6))

    plt.plot(
        w_normalizada,
        H_dB,
        label='FIR'
    )

    plt.axvline(
        fp_normalizada,
        linestyle='--',
        label='fp = 100 Hz'
    )

    plt.axvline(
        fstop_normalizada,
        linestyle='--',
        label='fstop = 300 Hz'
    )

    plt.axhline(
        -gpass,
        linestyle=':',
        label='-1 dB'
    )

    plt.axhline(
        -gstop,
        linestyle=':',
        label='-60 dB'
    )

    plt.title('Filtro FIR - Lowpass')

    plt.xlabel(
        'Frecuencia normalizada respecto de Nyquist'
    )

    plt.ylabel(
        'Magnitud [dB]'
    )

    plt.xlim(0, 1)
    plt.ylim(-100, 5)

    plt.grid(True)
    plt.legend()

    plt.show()


    # ========================================================
    # FORMATO PARA STM32 / CMSIS-DSP
    # ========================================================

    print("\n==============================================")
    print(" COEFICIENTES PARA STM32")
    print("==============================================")

    print("\nfloat32_t float_fir_taps[] =")
    print("{")

    for i, c in enumerate(taps):

        if i < len(taps) - 1:
            print(f"    {c:.10e}f,")
        else:
            print(f"    {c:.10e}f")

    print("};")
    
    
    
